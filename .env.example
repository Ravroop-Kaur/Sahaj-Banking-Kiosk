# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
# Used for natural-language intent classification and Gemini Live voice conversations.
GEMINI_API_KEY=
GEMINI_INTENT_MODEL=gemini-3.6-flash
GEMINI_OCR_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore

# Optional: comma-separated extra Live models to try automatically if the first one fails.
# GEMINI_LIVE_FALLBACK_MODELS=gemini-3.1-flash-live-preview,gemini-2.5-flash-native-audio-preview-12-2025

# --- Voice fallback (used when Gemini Live cannot connect and the browser has no working speech recognition) ---
# The kiosk records the customer in the page, the server transcribes it, then the normal flow continues.
# Tried in order: Gemini (plain HTTPS), Groq/OpenAI Whisper, local faster-whisper. Configure any one of them.
# GEMINI_STT_MODEL=gemini-3.6-flash
# Deepgram (fast dedicated speech-to-text; https://console.deepgram.com)
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=multi
# Change engine order (default: gemini,deepgram,whisper-api,whisper-local)
# VOICE_STT_ORDER=deepgram,gemini
# Groq has a free tier: https://console.groq.com  (also used as a backup for intent understanding)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# Offline option: pip install faster-whisper   (WHISPER_MODEL: tiny, base, small, medium)
# WHISPER_MODEL=small

# --- Passbook OCR on a hosted server (Render etc.) ---
# Total time allowed per passbook photo, across all engines.
# OCR_DEADLINE_SECONDS=35
# Engine order. Default gemini,vision-api,tesseract. On a server with a strong CPU you can use: tesseract,gemini
# OCR_ORDER=gemini,vision-api,tesseract
# Backup vision provider if Gemini is down (uses GROQ_API_KEY or OPENAI_API_KEY from above):
# OCR_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OCR_GEMINI_TIMEOUT=14

# --- Abuse protection for the endpoints that spend paid API quota (/api/voice/transcribe, /api/intent, /api/ocr/passbook) ---
# Requests per client per endpoint per minute. 0 turns the limit off.
# RATE_LIMIT_PER_MIN=60
# Set to 1 when running behind a proxy such as Render so the real client address is used (the Dockerfile sets it).
# TRUST_PROXY=1

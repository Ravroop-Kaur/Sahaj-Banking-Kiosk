# Copy to .env (never commit .env). Restart the kiosk after any change.
APP_MODE=demo
BANK_PROVIDER=demo
IDENTITY_PROVIDER=demo
PAYMENT_PROVIDER=demo

# Voice: gnani = Prisma STT + Timbre TTS primary (Gemini/browser as labelled fallbacks); gemini = previous behaviour.
VOICE_PROVIDER=gnani
GNANI_API_KEY=
# Verify these against the current Gnani docs and your account:
# GNANI_STT_MODEL=prisma-v3.0
# GNANI_TTS_MODEL=timbre-v2.5
# Timbre voices are per language. Defaults: hi-IN Nalini, en-IN Kaveri, pa-IN Mehuli,
# kn-IN Saanvi, ta-IN Asmita, bn-IN Kirra.
# GNANI_TTS_VOICE_EN_IN=Kaveri
# GNANI_TTS_VOICE_PA_IN=Mehuli
# GNANI_TTS_VOICE_KN_IN=Saanvi
# GNANI_TTS_VOICE_TA_IN=Asmita
# GNANI_TTS_VOICE_BN_IN=Kirra
# GNANI_TTS_SAMPLE_RATE=24000

# Fallbacks / existing options
GEMINI_API_KEY=
# OCR_MIN_FIELD_CONFIDENCE=0.85
# MIN_IMAGE_SHARPNESS=800
# SESSION_TIMEOUT_SECONDS=300
